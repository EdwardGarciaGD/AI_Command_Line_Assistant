# Example .env file for local development. Copy this to `.env` and fill in
# the real values. Never commit `.env` with real secrets to source control.

# Your AI provider API key (sensitive)
AI_API_KEY=sk-your_api_key_here

# The base URL for your AI provider's HTTP endpoint
AI_API_BASE_URL=https://api.provider.example/v1

# The model id you want to use (example: gpt-4)
AI_MODEL_NAME=gpt-4

# Optional: how many seconds to wait for provider responses (default 30)
AI_TIMEOUT_SECONDS=30

# Notes:
# - Keep `.env` out of source control. Use environment variables or a
#   secrets manager for production deployments.
# - Do not commit real API keys into your repository.
