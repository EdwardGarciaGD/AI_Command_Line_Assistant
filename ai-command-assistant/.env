# Local environment variables for development.
# Do NOT commit real secrets to version control. Keep this file private.

# Required: your AI provider API key
AI_API_KEY=sk-your_api_key_here

# Required: provider base URL (example: https://api.provider.example/v1)
AI_API_BASE_URL=https://api.provider.example/v1

# Required: model name to use (example: gpt-4)
AI_MODEL_NAME=gpt-4

# Optional: request timeout in seconds (default 30)
AI_TIMEOUT_SECONDS=30
